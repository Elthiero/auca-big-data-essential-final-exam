# Django configuration
DJANGO_SECRET_KEY=your_secret_key
DJANGO_DEBUG=True

# Database configuration
MYSQL_ROOT_PASSWORD=changeme
MYSQL_DATABASE=model_registry
MYSQL_USER=bigdata_user
MYSQL_PASSWORD=changeme

#aws rds configuration
# MYSQL_HOST=your-rds-endpoint.abcdefg.us-east-1.rds.amazonaws.com
# MYSQL_DATABASE=model_registry
# MYSQL_USER=your_rds_admin_username
# MYSQL_PASSWORD=your_rds_secure_password

# Kafka configuration
KAFKA_TOPIC=clickstream-events
REPLAY_RATE_EVENTS_PER_SEC=5000

# Model training configuration
# Accelerated for demo purposes. Set TRAINING_INTERVAL_SECONDS=2592000
# for the "true" monthly cadence described in the report.
TRAINING_INTERVAL_SECONDS=2592000
CHAMPION_IMPROVEMENT_THRESHOLD=0.02
MODEL_POLL_INTERVAL_SECONDS=30
PARQUET_TRIGGER_INTERVAL_SECONDS=60
MAX_EVENTS=
MODEL_TYPE=logistic_regression